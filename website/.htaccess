# ==============================================================================
# TypeBridge - InfinityFree / Apache .htaccess Configuration
# ==============================================================================

# 1. Automatic Fallback: Route APK and EXE requests to high-speed GitHub Release CDN
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^downloads/TypeBridge-Android.*\.apk$ https://github.com/loki-teche99/typebridge/releases/download/v1.0.1/TypeBridge-Android-v1.0.1.apk [R=302,L]
    RewriteRule ^downloads/TypeBridgeSetup.*\.exe$ https://github.com/loki-teche99/typebridge/releases/download/v1.0.1/TypeBridgeSetup-v1.0.1.exe [R=302,L]
</IfModule>

# 2. MIME Types for Installer & APK Downloads
AddType application/vnd.android.package-archive .apk
AddType application/octet-stream .exe
AddType application/json .json

# 3. Force Direct File Downloads (Prevent browser from opening binary files)
<FilesMatch "\.(apk|exe)$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, max-age=86400"
    </IfModule>
</FilesMatch>

# 4. Enable GZIP / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
</IfModule>

# 5. Browser Caching for Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 6. Security & Protection
Options -Indexes
ServerSignature Off

# 7. Default Index
DirectoryIndex index.html
