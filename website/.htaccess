# ==============================================================================
# TypeBridge - Production .htaccess Configuration (v1.0.2)
# Optimized for InfinityFree Apache Hosting & Fast Worldwide Downloads
# ==============================================================================

# 1. Routing & Direct Download Convenience
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Friendly download shortcuts
    RewriteRule ^apk/?$ download_apk.php [L]
    RewriteRule ^download/?$ download_apk.php [L]
</IfModule>

# 2. MIME Types for Installer, APK & Manifest Downloads
AddType application/vnd.android.package-archive .apk
AddType application/octet-stream .exe
AddType application/octet-stream .msix
AddType application/octet-stream .msixupload
AddType application/json .json

# 3. Force Binary Attachment Headers for Instant Downloads
<FilesMatch "\.(apk|exe|msix|msixupload)$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# 4. GZIP / Deflate Compression for High-Speed Page Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
</IfModule>

# 5. Browser Caching for Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 6. Security Hardening
Options -Indexes
ServerSignature Off

# 7. Default Directory Index
DirectoryIndex index.html index.php
