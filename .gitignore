TypeBridgeSetup-v*.exe
TypeBridge-Android-v*.apk
website/infinityfree_htdocs.zip
website/htdocs/
website/downloads/

# Python / Desktop
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
typebridge desktop assistant/build/
typebridge desktop assistant/dist/
typebridge desktop assistant/installer_output/
typebridge desktop assistant/msix_output/
