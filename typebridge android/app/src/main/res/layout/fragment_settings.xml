<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tb_card_border_dark"
            app:cardBackgroundColor="@color/tb_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="TypeBridge Logo"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TypeBridge Settings"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tb_text_primary_dark" />

                    <TextView
                        android:id="@+id/tvVersionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0.1 (Production Release)"
                        android:textSize="13sp"
                        android:textColor="@color/tb_text_secondary_dark" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Screen Button Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tb_card_border_dark"
            app:cardBackgroundColor="@color/tb_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Floating Screen Button"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_text_primary_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows a circular TypeBridge logo over other apps. Move it anywhere on screen. Tap to Paste or Send &amp; Type to your PC from WhatsApp, Chrome, Notes, or any app."
                    android:textSize="12sp"
                    android:textColor="@color/tb_text_secondary_dark"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOverlaySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Floating Screen Button"
                    android:textSize="14sp"
                    android:textColor="@color/tb_text_primary_dark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvOverlayPermHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requires 'Display over other apps' permission"
                    android:textSize="11sp"
                    android:textColor="@color/tb_accent_cyan" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Remote GitHub Auto-Updater Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tb_card_border_dark"
            app:cardBackgroundColor="@color/tb_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Remote GitHub Auto-Updater"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_text_primary_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatically checks GitHub Releases for new APK versions and seamlessly updates your app."
                    android:textSize="12sp"
                    android:textColor="@color/tb_text_secondary_dark"
                    android:layout_marginBottom="16dp" />

                <!-- Auto-Check Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check for updates automatically on launch"
                    android:textSize="14sp"
                    android:textColor="@color/tb_text_primary_dark"
                    android:checked="true"
                    android:layout_marginBottom="16dp" />

                <!-- Check For Updates Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="✨ Check for Updates Now"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/tb_accent_cyan"
                    android:textColor="#06080f" />

                <!-- Loading / Status indicator -->
                <LinearLayout
                    android:id="@+id/layoutUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <ProgressBar
                        android:id="@+id/pbChecking"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvUpdateStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking GitHub Releases..."
                        android:textSize="13sp"
                        android:textColor="@color/tb_text_secondary_dark" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Transport & Hardware Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tb_card_border_dark"
            app:cardBackgroundColor="@color/tb_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Hardware &amp; Transport Engine"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_text_primary_dark"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Primary Transport: Local Wi-Fi WebSocket (Port 8765)\n• Secondary Fallback: Bluetooth Classic SPP (RFCOMM)\n• Input Precision: Win32 SendInput 1:1 Kernel Keystrokes\n• Anti-Paste Immunity: 100% Undetectable (Zero Clipboard)\n• Background Lock: Active Low-Latency WifiLock + WakeLock"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/tb_text_secondary_dark" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Diagnostics & Support Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tb_card_border_dark"
            app:cardBackgroundColor="@color/tb_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺 Diagnostics &amp; System Health"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tb_text_primary_dark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export a sanitized diagnostic report with OS version, connection status, and hardware state for troubleshooting."
                    android:textSize="12sp"
                    android:textColor="@color/tb_text_secondary_dark"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📋 Copy Support Diagnostics"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    android:backgroundTint="#1e293b"
                    android:textColor="#38bdf8" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
